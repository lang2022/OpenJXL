---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Privacy | Open JXL" description="Files are processed in memory on your device only." path="/privacy/">
<section class="page-hero">
<span class="eyebrow">Privacy</span>
<h1>Your files <span class="grad">never leave this device</span></h1>
<p class="lead">Files are processed in memory on your device only. Closing or refreshing discards them.</p>
</section>

<section class="check-grid">
<div class="card check-card"><span class="check">✓</span><div><strong>No image uploads</strong><p>Decoding runs locally in your browser. There is no server endpoint that accepts files.</p></div></div>
<div class="card check-card"><span class="check">✓</span><div><strong>Anonymous events only</strong><p>We count previews, exports and detection outcomes - never file names or contents.</p></div></div>
<div class="card check-card"><span class="check">✓</span><div><strong>No ad cookies</strong><p>No advertising trackers. Statistics are cookieless (Plausible / Cloudflare).</p></div></div>
<div class="card check-card"><span class="check">@</span><div><strong>Contact</strong><p>Questions about privacy? Reach us at hello@example.com.</p></div></div>
</section>
</Base>

---
import { SITE } from '../i18n';
export interface Props { lang: 'en'|'zh'|'es'; title: string; description: string; path: string; h1?: string; noindex?: boolean; }
const { lang, title, description, path, noindex } = Astro.props;
const isZh = lang === 'zh'; const isEs = lang === 'es';
const stripLang = (p: string) => p.replace(/^\/(zh|es)\/?/, '/') || '/';
const basePath = (isZh || isEs) ? stripLang(path) : path;
const enPath = basePath;
const zhPath = basePath === '/' ? '/zh/' : '/zh' + basePath;
const esPath = basePath === '/' ? '/es/' : '/es' + basePath;
const canon = SITE + path;
const enAbs = SITE + (enPath.startsWith('/') ? enPath : '/' + enPath);
const zhAbs = SITE + zhPath;
const esAbs = SITE + esPath;
const navHow = isZh ? '如何打开' : isEs ? 'Cómo abrir' : 'How to open';
const navSup = isZh ? '浏览器支持' : isEs ? 'Soporte' : 'Browser support';
const navPri = isZh ? '隐私' : isEs ? 'Privacidad' : 'Privacy';
const howHref = isZh ? zhPath.replace(/\/$/, '') + '/how-to-open-jxl-file/' : isEs ? esPath.replace(/\/$/, '') + '/how-to-open-jxl-file/' : '/how-to-open-jxl-file/';
const supHref = isZh ? zhPath.replace(/\/$/, '') + '/jxl-browser-support/' : isEs ? esPath.replace(/\/$/, '') + '/jxl-browser-support/' : '/jxl-browser-support/';
const priHref = isZh ? zhPath.replace(/\/$/, '') + '/privacy/' : isEs ? esPath.replace(/\/$/, '') + '/privacy/' : '/privacy/';
const homeHref = isZh ? '/zh/' : isEs ? '/es/' : '/';
const langLabel = isZh ? '中文' : isEs ? 'ES' : 'EN';
---
<!DOCTYPE html>
<html lang={isZh ? 'zh-Hans' : isEs ? 'es' : 'en'}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />
<title>{title}</title>
<link rel="stylesheet" href="/site.css" />
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta property="og:image" content={SITE + '/og.png'} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Open JXL - preview JPEG XL files locally" />
<link rel="canonical" href={canon} />
<link rel="alternate" hreflang="en" href={enAbs} />
<link rel="alternate" hreflang="zh-Hans" href={zhAbs} />
<link rel="alternate" hreflang="es" href={esAbs} />
<link rel="alternate" hreflang="x-default" href={enAbs} />
<meta property="og:site_name" content="Open JXL" />
<meta name="author" content="Open JXL" />
<meta name="color-scheme" content="light dark" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f8fc" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a" />
<link rel="manifest" href="/site.webmanifest" />
{noindex ? <meta name="robots" content="noindex" /> : null}
<meta property="og:url" content={canon} />
<meta property="og:type" content="website" />
<meta name="twitter:image" content={SITE + '/og.png'} />
<script type="application/ld+json">{"@context":"https://schema.org","@type":"WebApplication","name":"Open JXL","url":"https://openjxlfile.com/","applicationCategory":"MultimediaApplication","operatingSystem":"Web","offers":{"@type":"Offer","price":"0"}}</script>
<script defer data-domain="openjxlfile.com" src="https://plausible.io/js/script.js"></script>
</head>
<body>
<a class="skip-link" href="#main">{isZh?'跳到内容':'Skip to content'}</a>
<header class="topbar"><div class="topbar-in">
<a class="logo" href={homeHref} aria-label="Open JXL home"><span class="logo-mark" aria-hidden="true">JX</span><span class="logo-text">Open JXL</span></a>
<nav class="topnav">
<a href={howHref}>{navHow}</a>
<a href={supHref}>{navSup}</a>
<a href={priHref}>{navPri}</a>
<details class="lang-menu"><summary>{langLabel} ▾</summary><div class="lang-list"><a href={enPath} class={lang==='en'?'on':''}>EN · English</a><a href={zhPath} class={isZh?'on':''}>中文 · 简体</a><a href={esPath} class={isEs?'on':''}>ES · Español</a></div></details>
</nav>
</div></header>
<main id="main"><div id="lang-hint" hidden></div><slot /></main>
<footer id="footer"><div class="foot-in">
<div><strong>Open JXL</strong><small id="seo-foot">{isZh?'JPEG XL 是一种图片格式。Open JXL 是本地查看器，与车机摄像头或 Java 库无关。':isEs?'JPEG XL es un formato de imagen. Open JXL es un visor local, no una app de cámara ni una librería Java.':'JPEG XL is an image format. Open JXL is a local viewer, not a camera app or Java library.'}</small><small>{isZh?'文件不上传。':isEs?'Nada se sube.':'Nothing is uploaded.'}</small></div>
<div class="foot-links">
<a href={howHref}>{navHow}</a>
<a href={supHref}>{navSup}</a>
<a href={priHref}>{navPri}</a>
</div>
</div></footer>
</body>
</html>
